<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every fixed dropdown in the project lives here - edit this file to add,
  remove, rename or reorder an option; no code change needed. Reload the
  page (Ctrl+F5) after saving.

  <list key="..." default="...">   key     = name the screens use (don't rename)
                                    default = option pre-selected (optional)
    <option>Text</option>           value saved = the text shown
    <option value="X">Text</option> value saved = X, text shown = Text

  Careful: changing an option's VALUE (or text, when there's no value
  attribute) can stop older saved records from matching it. Adding new
  options or changing only the shown text of a value="..." option is safe.
  Write & as &amp;
-->
