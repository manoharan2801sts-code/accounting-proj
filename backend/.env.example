# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# TiDB Cloud Serverless connection (from the cluster's "Connect" dialog)
DB_NAME=accounting_dep_db
DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=<prefix>.root
DB_PASSWORD=
DB_SSL=True

# Frontend origin allowed to call this API (django-cors-headers)
CORS_ALLOWED_ORIGIN=http://localhost:8080
