# ==========================================================================
# Voyager ERP — Environment Variables Template
# ==========================================================================

# Django Configuration
DJANGO_SECRET_KEY=change-this-to-a-random-secure-string-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# --------------------------------------------------------------------------
# Database Option 1: Connection URL (TiDB Cloud Connection String)
# --------------------------------------------------------------------------
# DATABASE_URL=mysql://<prefix>.root:<password>@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/accounting_dep_db?sslMode=VERIFY_IDENTITY

# --------------------------------------------------------------------------
# Database Option 2: Individual Connection Variables
# --------------------------------------------------------------------------
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=accounting_dep_db
DB_USER=xxxxxx.root
DB_PASSWORD=your_tidb_password_here
DB_SSL=True

# CORS Origin (optional, defaults to allowing same-origin and render domain)
CORS_ALLOW_ALL=True
